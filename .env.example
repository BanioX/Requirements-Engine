# Beispielkonfiguration — kopiere diese Datei nach `.env` und ersetze die Platzhalter.
# Niemals echte Passwörter oder Tokens in Git committen!

APP_PORT=3000
NODE_ENV=production

POSTGRES_DB=reqengine
POSTGRES_USER=reqengine
POSTGRES_PASSWORD=HIER_EIGENES_PASSWORT_SETZEN

# Optional: Nur nötig bei Einbettung als Confluence-Makro / Intranet-Iframe
# Beispiel: EMBED_ALLOWED_ORIGINS=https://*.atlassian.net
EMBED_ALLOWED_ORIGINS=

# Optional: Nur nötig für direkten Jira-REST-API-Export (Story / Feature)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Optional: Nur nötig bei Cloudflare Named Tunnel (bei Quick Tunnel leer lassen)
CLOUDFLARE_TUNNEL_TOKEN=
